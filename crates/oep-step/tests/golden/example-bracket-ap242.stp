ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('oep-pmi example-bracket AP242 semantic PMI export', 'P4-M2-T02'),'2;1');
FILE_NAME('example-bracket-ap242.stp','',('Isolith OEP'),(''),'oep-step 0.1.0','Isolith OEP','');
FILE_SCHEMA (('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;

DATA;
#1=APPLICATION_CONTEXT('mechanical design');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','managed_model_based_3d_engineering',2018,#1);
#3=PRODUCT_CONTEXT('',#2,'mechanical');
#4=PRODUCT('example-bracket','example-bracket','oep-pmi PMI model',(#3));
#5=PRODUCT_DEFINITION_FORMATION('','',#4);
#6=PRODUCT_DEFINITION_CONTEXT('part definition',#2,'design');
#7=PRODUCT_DEFINITION('design','',#5,#6);
