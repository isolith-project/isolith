#9=( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#10=( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#11=( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#12=( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNIT_ASSIGNED_CONTEXT((#9,#10,#11)) REPRESENTATION_CONTEXT('','') );
#13=DATUM('datum_A|oep-feature-bracket-extrude',$,#8,.F.,'A');
#14=DATUM('datum_B|oep-feature-bracket-hole',$,#8,.F.,'B');
#15=DATUM('datum_C|oep-feature-bracket-hole',$,#8,.F.,'C');
#16=DATUM_REFERENCE_COMPARTMENT('',$,#8,.F.,#13,(SIMPLE_DATUM_REFERENCE_MODIFIER(.REGARDLESS_OF_FEATURE_SIZE.)));
#17=DATUM_REFERENCE_COMPARTMENT('',$,#8,.F.,#14,(SIMPLE_DATUM_REFERENCE_MODIFIER(.REGARDLESS_OF_FEATURE_SIZE.)));
#18=DATUM_REFERENCE_COMPARTMENT('',$,#8,.F.,#15,$);
#19=DATUM_SYSTEM('drf_abc',$,#8,.F.,(#16,#17,#18));
#20=( LENGTH_MEASURE_WITH_UNIT() MEASURE_REPRESENTATION_ITEM() MEASURE_WITH_UNIT(LENGTH_MEASURE(0.2),#9) REPRESENTATION_ITEM('') );
#21=SHAPE_ASPECT('oep-feature-bracket-hole','',#8,.F.);
#22=(GEOMETRIC_TOLERANCE('gt_1','',#20,#21)
GEOMETRIC_TOLERANCE_WITH_DATUM_REFERENCE((#19))
GEOMETRIC_TOLERANCE_WITH_MODIFIERS((.MAXIMUM_MATERIAL_REQUIREMENT.))
POSITION_TOLERANCE());
#23=TOLERANCE_ZONE_FORM('cylindrical or circular');
#24=TOLERANCE_ZONE('',$,#8,.F.,(#22),#23);
#25=( LENGTH_MEASURE_WITH_UNIT() MEASURE_REPRESENTATION_ITEM() MEASURE_WITH_UNIT(LENGTH_MEASURE(0.05),#9) REPRESENTATION_ITEM('') );
#26=SHAPE_ASPECT('oep-feature-bracket-extrude','',#8,.F.);
#27=(GEOMETRIC_TOLERANCE('gt_flat','',#25,#26)
FLATNESS_TOLERANCE());
#28=( LENGTH_MEASURE_WITH_UNIT() MEASURE_REPRESENTATION_ITEM() MEASURE_WITH_UNIT(LENGTH_MEASURE(0.1),#9) REPRESENTATION_ITEM('') );
#29=SHAPE_ASPECT('oep-feature-bracket-hole','',#8,.F.);
#30=(GEOMETRIC_TOLERANCE('gt_perp','',#28,#29)
GEOMETRIC_TOLERANCE_WITH_DATUM_REFERENCE((#19))
GEOMETRIC_TOLERANCE_WITH_MODIFIERS((.REGARDLESS_OF_FEATURE_SIZE.))
PERPENDICULARITY_TOLERANCE());
#31=DESCRIPTIVE_REPRESENTATION_ITEM('note_holes|oep-feature-bracket-hole','4X \X2\00D8\X0\6.00 THRU');
#32=DESCRIPTIVE_REPRESENTATION_ITEM('note_units','ALL DIMENSIONS IN MM');
#33=REPRESENTATION('oep-pmi notes',(#31,#32),#12);
#34=SHAPE_DEFINITION_REPRESENTATION(#8,#33);
ENDSEC;
