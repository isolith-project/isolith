# Isolith OEP stack - NAS operator environment (DOCKER-NAS-DEPLOYMENT).
# Copy to .env (Synology Container Manager: Project env, or same dir) and edit.
#
# Defaults keep the stack LAN-off (127.0.0.1) and PDM auth ON. Do not weaken.

# GHCR image reference + version (per release; the gated GHCR push is recorded
# in the release body with its digest). Change to a private/pre-release tag or
# an offline-bundle-loaded tag until the first public GHCR push lands.
OEP_IMAGE=ghcr.io/isolith/oep-stack:0.1.0

# PDM (oep-pdm, P8 REST API v1). Container side fixed at 8787.
# SECURE BY DEFAULT: the command enforces the RBAC boundary - never add --no-auth.
# To serve the team on the LAN, set OEP_PDM_BIND to the NAS LAN IP (behind a
# reverse proxy for TLS).
OEP_PDM_BIND=127.0.0.1
OEP_PDM_PORT=8787

# P6 preview viewer (oep-web). Container side fixed at 8790.
OEP_VIEWER_BIND=127.0.0.1
OEP_VIEWER_PORT=8790

# P2P compute dashboard (oep-opsdash). Container side fixed at 8080.
OEP_P2P_BIND=127.0.0.1
OEP_P2P_PORT=8080

# Docs site (oep-docs). Container side fixed at 8792.
OEP_DOCS_BIND=127.0.0.1
OEP_DOCS_PORT=8792
