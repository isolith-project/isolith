#!/usr/bin/env bash
# git credential helper: answer for https://github.com using dmltallen's
# keyring token (redonealpha-don, the gh-active account, has no write to
# isolith-project/isolith -> 403). Scoped per-command via
#   -c credential.https://github.com.helper="!path/git-credential-dmltallen"
# so the host-global active gh account is never switched (no race with
# concurrent workers). Reads the token from the keyring at call time; it
# never appears on a command line or in this file.
read -r line
while [ -n "$line" ]; do
  case "$line" in
    protocol=*) protocol="${line#protocol=}" ;;
    host=*)    host="${line#host=}" ;;
    username=*) username="${line#username=}" ;;
  esac
  read -r line
done
[ "$protocol" = "https" ] || exit 0
case "$host" in
  github.com|*.github.com) ;;
  *) exit 0 ;;
esac
case "${username:-}" in
  ""|dmltallen|redonealpha-don|don) ;;
  *) exit 0 ;;
esac
echo "username=dmltallen"
echo "password=$(gh auth token --user dmltallen 2>/dev/null)"
exit 0
