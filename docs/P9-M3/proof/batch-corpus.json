{
  "format": "oep-batch",
  "version": 1,
  "description": "P9-M3-T02 corpus batch - CGR->glTF (P2 dogfood) + STEP->mesh (P4 dogfood); outputs hash-verified in the P8 vault",
  "jobs": [
    {
      "format": "oep-job",
      "version": 1,
      "name": "cgr-stc06",
      "description": "P9-M3-T02 proof run: cgr2gltf",
      "input": [
        {
          "name": "source",
          "ref": {
            "kind": "item",
            "item_id": "corpus-stc06"
          }
        }
      ],
      "executor": {
        "kind": "convert",
        "function": "cgr2gltf"
      },
      "resources": {
        "cpu_millicores": 1000,
        "memory_mib": 2048
      },
      "output": [
        {
          "name": "out",
          "format": "gltf",
          "target": {
            "kind": "attach_item",
            "item_id": "out-stc06"
          }
        }
      ]
    },
    {
      "format": "oep-job",
      "version": 1,
      "name": "cgr-valve",
