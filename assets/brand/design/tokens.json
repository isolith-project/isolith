{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": {
    "$type": "string",
    "name": "isolith",
    "product": "Isolith",
    "expandedName": "Isolith: Open Engineering Platform (OEP)",
    "tagline": "the open engineering platform"
  },
  "color": {
    "ink": { "$type": "color", "$value": "#0F2A43" },
    "plate": { "$type": "color", "$value": "#1D5B9E" },
    "steel": { "$type": "color", "$value": "#7C94AD" },
    "slate": { "$type": "color", "$value": "#546981" },
    "accent": { "$type": "color", "$value": "#C8792B" },
    "paper": { "$type": "color", "$value": "#F6F4EF" },
    "white": { "$type": "color", "$value": "#FFFFFF" }
  },
  "font": {
    "display": { "$type": "string", "$value": "'Space Grotesk', 'IBM Plex Sans', system-ui, sans-serif" },
    "body": { "$type": "string", "$value": "'Inter', 'IBM Plex Sans', system-ui, -apple-system, sans-serif" },
    "code": { "$type": "string", "$value": "'IBM Plex Mono', 'JetBrains Mono', ui-monospace, monospace" }
  },
  "type": {
    "displayXl": { "$type": "string", "$value": "700 3rem/1.05 Space Grotesk, letter-spacing -0.01em" },
    "displayLg": { "$type": "string", "$value": "600 2.5rem/1.1 Space Grotesk, letter-spacing -0.01em" },
    "h1": { "$type": "string", "$value": "600 2rem/1.15 Space Grotesk" },
    "h2": { "$type": "string", "$value": "600 1.5rem/1.2 Space Grotesk" },
    "h3": { "$type": "string", "$value": "600 1.125rem/1.3 Space Grotesk" },
    "bodyMd": { "$type": "string", "$value": "400 1rem/1.6 Inter" },
    "bodySm": { "$type": "string", "$value": "400 0.875rem/1.55 Inter" },
    "labelCaps": { "$type": "string", "$value": "600 0.75rem/1.2 Inter, letter-spacing 0.08em, uppercase" },
    "code": { "$type": "string", "$value": "400 0.875rem/1.5 'IBM Plex Mono'" }
  },
  "space": {
    "xs": { "$type": "dimension", "$value": 4 },
    "sm": { "$type": "dimension", "$value": 8 },
    "md": { "$type": "dimension", "$value": 16 },
    "lg": { "$type": "dimension", "$value": 24 },
    "xl": { "$type": "dimension", "$value": 32 },
    "xxl": { "$type": "dimension", "$value": 48 }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": 4 },
    "md": { "$type": "dimension", "$value": 8 },
    "lg": { "$type": "dimension", "$value": 12 }
  },
  "logo": {
    "mark": { "$type": "string", "$value": "assets/brand/logo/isolith-mark.svg" },
    "markDark": { "$type": "string", "$value": "assets/brand/logo/isolith-mark-dark.svg" },
    "markMono": { "$type": "string", "$value": "assets/brand/logo/isolith-mark-mono.svg" },
    "lockup": { "$type": "string", "$value": "assets/brand/logo/isolith-lockup.svg" },
    "favicon": { "$type": "string", "$value": "assets/brand/logo/favicon.svg" }
  }
}
