# git worktrees (worktree-isolation discipline)
.worktrees/

# Python artifacts
__pycache__/
*.pyc

# Rust build artifacts (cargo workspace)
/target/

# C/C++ build artifacts (CMake)
build/
*.o
*.a
*.so

# Python local venv (uv)
.venv/

# Quality-gate test fixtures (unique names only; a generic broken.py must never
# be committed even if a tmpdir fixture strays into the repo root).
broken.py

# Dev-only real-material corpus for the P9-M5-T02 GA gate (clean-room
# invariant: real CAD/CATPart bytes are reference material, never committed).
pending-corpus/

# P10-M1-T01 one-command stack: locally generated env + release bundles
# (offline image tarballs + checksums) are build artifacts, not source.
P10-M1/deploy/.env
P10-M1/releases/
# Editor-assem mechanism motion recording frames: regenerated deterministically
# by the performance/CI run; the trace + manifest are the committed record.
/demos/editor-assem-motion/frames/
# P10-M4 replication proof scratch (aggregated JSON/MD are the artifacts)
P10-M4/proof/.local-rows.jsonl
P10-M4/proof/.remote-rows.jsonl
P10-M4/proof/.pdm-live.log
P10-M4/proof/.vault-live/
# P10-M1-T02: generated TLS identities (CA + leaf private keys) must never be
# committed; the gen-stack-certs.sh tooling recreates them per host.
P10-M1/certs/
*.srl
server.key

# P11-T02: the rustsec advisory-db is a shallow clone cache, never committed
# (source of truth is upstream rustsec/advisory-db at scan time).
P11/.advisory-db/
