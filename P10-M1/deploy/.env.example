# Keelworks OEP stack environment (P10-M1-T01).
# Copy to .env and edit the host-side bind/port if the defaults conflict.
# The default bind (127.0.0.1) keeps the stack LAN-off until the operator
# publishes it -- on-prem/sovereignty posture, decision #10.

# Image version tag (align with release.sh <version>).
OEP_VERSION=0.1.0

# PDM (oep-pdm, P8 REST API v1). Container side is fixed at 8787.
# SECURE BY DEFAULT (SEC-AUTHZ-DEFAULT): the pdm command enforces the P11-T03
# RBAC boundary; the client must send X-Oep-User / X-Oep-Roles / X-Oep-Tenant
# (authorization-grade headers until the P8-M3-T01 identity layer lands). To
# opt out to the open contract for controlled test / air-gap use ONLY, add
# "--no-auth" to the pdm command in docker-compose.yml (it prints a loud
# startup warning that authorization is disabled).
OEP_PDM_BIND=127.0.0.1
OEP_PDM_PORT=8787

# Viewer (oep-web, P6 preview viewer + browser UI). Container side fixed at 8790.
OEP_VIEWER_BIND=127.0.0.1
OEP_VIEWER_PORT=8790

# P2P compute dashboard (oep-opsdash live). Container side fixed at 8080.
OEP_P2P_BIND=127.0.0.1
OEP_P2P_PORT=8080
